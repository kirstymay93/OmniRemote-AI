{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch OmniRemote AI",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/index.js",
      "cwd": "${workspaceFolder}",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "restart": true
    }
  ]
}